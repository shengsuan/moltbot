  "gateway": {
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN:-changeme}"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:10789",
        "http://127.0.0.1:10789",
        "http://100.64.0.1:10789",
        "${OPENCLAW_GATEWAY_CONTROL_UI_ALLOWED_ORIGIN:-}"
