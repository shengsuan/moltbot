        "source": "npm",
        "spec": "@wecom/wecom-openclaw-plugin@latest",
        "installPath": "/home/node/.openclaw/extensions/wecom-openclaw-plugin"
      },
      "openclaw-weixin": {
        "source": "npm",
        "installPath": "/home/node/.openclaw/extensions/openclaw-weixin",
